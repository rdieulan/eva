# Base de données
DATABASE_URL="postgresql://eva_user:eva_secret_password@localhost:5432/eva_db"

# Application
NODE_ENV="development"
PORT=3001
# L'adresse publique du site : les liens des notifications postées hors de
# l'application (Discord), et la seule origine d'où le serveur accepte des
# modifications : en dev, le serveur Vite.
APP_URL="http://localhost:5173"

# Se connecter à n'importe quel compte local sans Discord, pour les vérifications :
# à activer dans .env.local (DEV_LOGIN="true"), jamais actif en production. Les
# secrets de l'application Discord y vont aussi : DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET.
DEV_LOGIN="false"
