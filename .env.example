# Base de données (Railway génère automatiquement DATABASE_URL)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Authentification
JWT_SECRET="votre_secret_jwt_a_changer_en_production"
JWT_EXPIRES_IN="7d"

# Application
NODE_ENV="production"
PORT=3001
# L'adresse publique du site, pour les liens des notifications postées hors de
# l'application (Discord) ; sans elle, elles partent sans lien
APP_URL="https://exemple.fr"
