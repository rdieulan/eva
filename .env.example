# Base de données (Railway génère automatiquement DATABASE_URL)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Application
NODE_ENV="production"
PORT=3001
# L'adresse publique du site : les liens des notifications postées hors de
# l'application (Discord), et la seule origine d'où le serveur accepte des
# modifications. Sans elle, les notifications partent sans lien et le site
# ne peut rien modifier.
APP_URL="https://exemple.fr"

# Connexion par Discord : l'application créée sur discord.com/developers, dont
# l'adresse de retour est APP_URL + /api/auth/discord/callback. Le secret ne se
# commite jamais : en dev, ces deux lignes vont dans .env.local.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Qui publie le site, tel que la page Données personnelles le montre : son nom
# et l'e-mail où le joindre. Sur le déploiement seulement,
# jamais commités : le dépôt est public. Son identité complète (domicile,
# téléphone) va à l'hébergeur, pas ici.
PUBLISHER_NAME=""
PUBLISHER_EMAIL=""

# En dev seulement : se connecter à n'importe quel compte local sans Discord.
# Jamais actif en production, quoi qu'on règle ici.
DEV_LOGIN="false"
