generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Accounts & sessions
// ============================================

// One person, signed in with their Discord account. Everyone is a player;
// managing a venue and administering the app are roles on top, given by
// invitation. Nothing else of the Discord account is kept: no email, no avatar.
model User {
  id          String    @id @default(cuid())
  discordId   String    @unique // The Discord account's number, which never changes
  name        String // Shown to the others; taken from Discord at the first login, changed on the profile
  playerId    String    @unique
  managerId   String?   @unique
  adminId     String?   @unique
  // When the first-login walk-through was done or skipped: it shows once
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  manager     Manager?  @relation(fields: [managerId], references: [id], onDelete: SetNull)
  admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  sessions    Session[]
}

// Who a request acts for. The browser keeps a random token in a cookie; only
// its hash is kept here, so a copy of the database opens no session
model Session {
  id        String      @id @default(cuid())
  userId    String
  tokenHash String      @unique // SHA-256 of the token, hex
  role      AccountRole @default(PLAYER) // The role of the account the session acts as
  expiresAt DateTime // Pushed back while the session is used
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// Player (joueur affilié à une équipe)
// ============================================

model Player {
  id                      String                   @id @default(cuid())
  permissions             Json? // Granular permissions JSON
  teamId                  String?
  subscriptionTier        SubscriptionTier?
  subscriptionRenewalDate DateTime?                @db.Date // Renews every 30 days from this date
  evaUserId               Int?                     @unique // User id on eva.gg, stable across renames; one eva.gg account per player
  evaUsername             String? // eva.gg tag (Pseudo#123456) as it was when the player linked it; display only
  evaLinkedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User?
  team                    Team?                    @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeam                 Team?                    @relation("TeamLeader")
  availabilities          Availability[]
  createdEvents           CalendarEvent[]
  gamePlanPlayers         GamePlanPlayer[]
  createdInvites          TeamInvite[]
  openedScrimSearches     ScrimSearch[]
  sentScrimProposals      ScrimProposal[]
  notificationInbox       NotificationInboxEntry[]
  joinRequests            TeamJoinRequest[]

  @@index([teamId])
}

// ============================================
// Manager (gérant de salle)
// ============================================

// A manager without an account is an invitation not yet accepted: its link
// carries the activation token, and the name the admin gave it shows until then
model Manager {
  id                       String         @id @default(cuid())
  permissions              Json? // Manager-specific permissions
  activationToken          String?        @unique
  activationTokenExpiresAt DateTime?
  invitedName              String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  user                     User?
  managedVenues            VenueManager[]
}

// ============================================
// Admin (administrateur)
// ============================================

// An admin without an account is an invitation not yet accepted, as for managers
model Admin {
  id                       String    @id @default(cuid())
  permissions              Json // Toutes les permissions admin (superAdmin = toutes à true)
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  invitedName              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User?
}

// ============================================
// Team & Venue
// ============================================

model Team {
  id                      String                  @id @default(cuid())
  name                    String
  // The team's logo, a small image kept in the database so it survives redeploys
  logoData                Bytes?
  logoType                String? // image/png, image/jpeg or image/webp, as read from the file itself
  logoUpdatedAt           DateTime? // Changes the logo URL, so browsers drop their cached copy
  // Where the team's notifications are posted on Discord: the webhook of one of
  // its channels. A secret, since whoever holds it posts there: never sent back
  // to the app, and left out of every team query that does not ask for it
  discordWebhookUrl       String?
  discordWebhookBrokenAt  DateTime? // When Discord refused to post there (webhook deleted): nothing more goes until it is replaced
  venueId                 String?
  // The league team it is on competitive.eva.gg, one team of ours for each:
  // whoever finds that league team in the directory finds this team with it
  leagueTeamId            String?                 @unique
  // How many days ahead, today included, its players are asked for their
  // availability; set by whoever manages the team (AVAILABILITY_HORIZON_* in shared/constants)
  availabilityHorizonDays Int                     @default(15)
  leaderId                String                  @unique
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  venue                   Venue?                  @relation(fields: [venueId], references: [id])
  leagueTeam              LeagueTeam?             @relation(fields: [leagueTeamId], references: [id], onDelete: SetNull)
  leader                  Player                  @relation("TeamLeader", fields: [leaderId], references: [id])
  members                 Player[]                @relation("TeamMembers")
  balanceRules            BalanceRule[]
  gamePlans               GamePlan[]
  calendarEvents          CalendarEvent[]
  invites                 TeamInvite[]
  favoriteVenues          TeamFavoriteVenue[]
  scrimSearches           ScrimSearch[]
  scrimProposals          ScrimProposal[]
  notifications           Notification[]
  joinRequests            TeamJoinRequest[]
  leagueEntries           LeagueEntry[]
  competitionOffers       VenueCompetitionOffer[]

  @@index([venueId])
}

// The venues a team plays at most often, in the order the team listed them.
// Quick access in the venue pickers; distinct from the affiliated venue.
model TeamFavoriteVenue {
  teamId   String
  venueId  String
  position Int
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([teamId, venueId])
  @@index([venueId])
}

model Venue {
  id                     String                @id @default(cuid())
  externalId             Int?                  @unique // Location id on eva.gg, for venues filled by scripts/sync-venues.ts
  slug                   String                @unique // Its name in the address of its public board, set once: renamed, it keeps the links already shared
  name                   String
  city                   String
  address                String
  phone                  String?
  arenaCount             Int                   @default(1) // Arenas the venue runs for the competitive game
  // Where the venue can be reached online, as eva.gg publishes them; hand-made venues fill them in the admin
  website                String?
  discord                String?
  facebook               String?
  instagram              String?
  x                      String?
  tiktok                 String?
  youtube                String?
  twitch                 String?
  // How many divisions its local league has, as its manager arranges them
  leagueDivisionCount    Int                   @default(0)
  // Where the venue's publications are to be posted on Discord: the webhook of a
  // channel of its own server, linked by its manager. A secret, as a team's:
  // never sent back to the app, and left out of every query that does not ask for it
  discordWebhookUrl      String?
  discordWebhookBrokenAt DateTime? // When Discord refused to post there (webhook deleted): nothing more goes until it is replaced
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  teams                  Team[]
  managers               VenueManager[]
  matches                CalendarEvent[]
  favoredBy              TeamFavoriteVenue[]
  scrimSlots             ScrimSearchSlot[]
  scrimRuns              ScrimProposal[]
  leagueTournaments      LeagueTournament[]
  leagueDivisionPlaces   LeagueDivisionPlace[]
  competitions           VenueCompetition[]
  events                 VenueEvent[]
}

model VenueManager {
  id        String   @id @default(cuid())
  managerId String
  venueId   String
  createdAt DateTime @default(now())
  manager   Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([managerId, venueId])
  @@index([managerId])
  @@index([venueId])
}

// A team of the leagues played on competitive.eva.gg, as the site's public list
// of After-H teams shows it, read again every night: a player finds their team
// there by its name and knows it by its logo. Who plays in it is not kept.
model LeagueTeam {
  id            String               @id // Its id on competitive.eva.gg
  name          String
  searchName    String // The name as a search compares it: lowercase, no accents, one space between words
  memberCount   Int
  logoId        String? // Its current logo there, a new id for each new logo; null when it has none
  // Its logo, copied the first time it is shown, for whoever looks next
  logoData      Bytes?
  logoType      String? // image/png, image/jpeg or image/webp, as read from the image itself
  logoCopiedId  String? // Which of its logos logoData holds: a stale copy once logoId moves on
  seenAt        DateTime // The last read of the list it was in
  team          Team? // The team of ours it is, when one is linked to it
  divisionPlace LeagueDivisionPlace?
}

// Where a league team plays in the local league of a venue, as the venue's
// manager arranges its divisions: competitive.eva.gg tells a month's
// divisions only once the month is drawn, too late to plan its days
model LeagueDivisionPlace {
  leagueTeamId String     @id // A league team plays in one local league
  venueId      String
  division     Int? // 1 is the top division; null while it waits to be placed
  position     Int // Its rank in its column, from 0
  updatedAt    DateTime   @updatedAt
  leagueTeam   LeagueTeam @relation(fields: [leagueTeamId], references: [id], onDelete: Cascade)
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

// A competition a venue's manager publishes in the venue's calendar and offers
// its teams: a day of a division of its local league, or a tournament of the
// venue. The manager gives the dates: those of a month past say nothing of
// the next ones.
model VenueCompetition {
  id          String                  @id @default(cuid())
  venueId     String
  division    Int? // The division whose day it is; null for a tournament of the venue
  title       String
  date        DateTime                @db.Date
  startTime   String // HH:mm
  endTime     String // HH:mm
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  venue       Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  offers      VenueCompetitionOffer[]
  teamEvents  CalendarEvent[]

  @@index([venueId, date])
}

// What a team says of a competition a venue published for it: a division's day
// goes to the teams of that division, a tournament of the venue to all its
// teams. Those who can create the team's events accept it into its calendar,
// or refuse it.
model VenueCompetitionOffer {
  competitionId String
  teamId        String
  status        VenueCompetitionOfferStatus @default(PENDING)
  answeredAt    DateTime?
  createdAt     DateTime                    @default(now())
  competition   VenueCompetition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team          Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([competitionId, teamId])
  @@index([teamId, status])
}

enum VenueCompetitionOfferStatus {
  PENDING
  ACCEPTED
  REFUSED
}

// An event a venue's manager publishes in the venue's calendar, open to all,
// league teams or not and players alone: a night session, and what comes next.
// Offered to no team: the teams whose venue it is see it in their calendar as
// not taken yet, and those who make a team's events add it there, a copy tied
// to it that goes when the venue withdraws it.
model VenueEvent {
  id          String          @id @default(cuid())
  venueId     String
  title       String
  date        DateTime        @db.Date
  startTime   String // HH:mm
  endTime     String // HH:mm
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  venue       Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  teamEvents  CalendarEvent[]

  @@index([venueId, date])
}

// A tournament of a local league of competitive.eva.gg: each month of a league
// is one, with its own registration. Read every night for the leagues our
// linked teams play in, and forgotten a month after its registration closed.
model LeagueTournament {
  id                   String        @id // Its id on competitive.eva.gg
  name                 String
  regionId             String // The league it is a month of: one region of the local leagues per venue
  venueId              String? // That venue, when it is one of ours
  startsOn             DateTime?     @db.Date
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  seenAt               DateTime // The last night it was read
  venue                Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  entries              LeagueEntry[]

  @@index([regionId])
  @@index([venueId])
}

// A team of ours and a tournament of its local league whose registration is
// open: whether the team is registered, as the site lists it, and what those
// who manage it were told. Each reminder goes once. Read for the league team
// the team is linked to: dropped when the team leaves that link.
model LeagueEntry {
  teamId          String
  tournamentId    String
  registeredAt    DateTime? // When a night first found the team registered; null while it is not
  openNoticeAt    DateTime? // When the team was told the registration opened
  closingNoticeAt DateTime? // When the team was told it closes in a few days
  checkedAt       DateTime // The last night the team's registration was read
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournament      LeagueTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@id([teamId, tournamentId])
  @@index([tournamentId])
}

// ============================================
// Game Plans & Maps
// ============================================

model Map {
  id        String     @id
  name      String
  images    Json       @default("[]")
  template  Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  gamePlans GamePlan[]
}

model GamePlan {
  id          String           @id @default(cuid())
  name        String
  mapId       String
  teamId      String?
  assignments Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  notes       Json?
  map         Map              @relation(fields: [mapId], references: [id], onDelete: Cascade)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players     GamePlanPlayer[]

  @@index([mapId])
  @@index([teamId])
}

model GamePlanPlayer {
  id               String   @id @default(cuid())
  gamePlanId       String
  playerId         String
  assignmentIds    Int[]
  mainAssignmentId Int?
  gamePlan         GamePlan @relation(fields: [gamePlanId], references: [id], onDelete: Cascade)
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gamePlanId, playerId])
  @@index([gamePlanId])
  @@index([playerId])
}

// ============================================
// Calendar & Availability
// ============================================

model Availability {
  id        String             @id @default(cuid())
  playerId  String
  date      DateTime           @db.Date
  status    AvailabilityStatus
  startTime String? // HH:mm, PARTIAL only: available to play from then; none means from the start of the day
  endTime   String? // HH:mm, PARTIAL only: available to play until then; none means until the end of the day
  player    Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@index([date])
}

model CalendarEvent {
  id                 String            @id @default(cuid())
  date               DateTime          @db.Date
  startTime          String
  endTime            String
  type               EventType
  title              String
  description        String?
  teamId             String?
  venueId            String? // Where a MATCH is played; other event types have none
  arenaNumber        Int? // Which arena of that venue, when the team knows it
  evaSlotIds         String[]          @default([]) // The eva.gg slots the match runs on, consecutive on one arena, in order; empty when none picked
  voiceMedium        VoiceMedium? // Where a VOICE_MEETING is held; other event types have none
  scrimSearchId      String? // The search this match came out of, when the matchmaking created it
  // The venue competition this one is the team's copy of, once the team accepted it: withdrawn by the venue, it goes
  venueCompetitionId String?
  // The venue event this one is the team's copy of, once the team added it: withdrawn by the venue, it goes
  venueEventId       String?
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  gamePlan           Json?
  team               Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  venue              Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdBy          Player            @relation(fields: [createdById], references: [id])
  scrimSearch        ScrimSearch?      @relation(fields: [scrimSearchId], references: [id], onDelete: SetNull)
  venueCompetition   VenueCompetition? @relation(fields: [venueCompetitionId], references: [id], onDelete: Cascade)
  venueEvent         VenueEvent?       @relation(fields: [venueEventId], references: [id], onDelete: Cascade)

  // A team adds a venue's event once
  @@unique([teamId, venueEventId])
  @@index([date])
  @@index([teamId])
  @@index([venueId])
  @@index([scrimSearchId])
  @@index([venueCompetitionId])
  @@index([venueEventId])
}

// A team's offer for a day: slots of one venue or more, and how many matches
// it wants to play on them that day, wherever they are played, each on a run
// of consecutive slots of one arena. A team plays one match at a time, so no
// two matches of a search overlap. One open search per team and day; a
// withdrawn search is deleted.
model ScrimSearch {
  id              String            @id @default(cuid())
  teamId          String
  date            DateTime          @db.Date
  slotCount       Int               @default(2) // How many consecutive slots a match takes (see SCRIM_MATCH_SLOTS_DEFAULT)
  matchCount      Int               @default(1) // How many matches the team wants that day (see SCRIM_MATCH_COUNT_DEFAULT)
  startTime       String // HH:mm, earliest offered slot
  endTime         String // HH:mm, end of the latest offered slot
  convocationTime String // HH:mm, when eva.gg expects the players for the earliest slot
  status          ScrimSearchStatus @default(OPEN)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  team            Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       Player            @relation(fields: [createdById], references: [id])
  slots           ScrimSearchSlot[]
  proposals       ScrimProposal[]
  matches         CalendarEvent[] // The match events its accepted proposals created, two per match

  @@index([teamId, date])
}

// A slot a search offers, with its venue, arena and times as eva.gg gave them
// when the search opened: the offer reads, and counts the matches it still
// holds, without asking eva.gg again
model ScrimSearchSlot {
  id              String      @id @default(cuid())
  searchId        String
  venueId         String
  evaSlotId       String
  arenaNumber     Int
  startTime       String // HH:mm
  endTime         String // HH:mm
  convocationTime String // HH:mm
  position        Int // Venue by venue in the team's order, arena by arena, then by time
  search          ScrimSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  venue           Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([searchId, evaSlotId])
  @@index([venueId])
}

// A team answers another team's search with the run of one match, in one of
// its venues. Accepting it creates the match in both calendars and declines
// the pending proposals at the same time; the search closes, declining the
// rest, once it has all its matches or its remaining slots no longer hold one.
model ScrimProposal {
  id              String              @id @default(cuid())
  searchId        String
  teamId          String // The team proposing, never the one that opened the search
  createdById     String
  message         String? // A word for the other team, optional
  venueId         String // Where the run is played
  evaSlotIds      String[] // The run to play: consecutive slots on one arena, among those the search offers
  arenaNumber     Int
  startTime       String // HH:mm, first slot of the run
  endTime         String // HH:mm, last slot of the run
  convocationTime String // HH:mm, for the first slot
  status          ScrimProposalStatus @default(PENDING)
  declineReason   ScrimDeclineReason? // Why it was declined: set on a declined proposal, on no other (a check in the database says so)
  respondedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  search          ScrimSearch         @relation(fields: [searchId], references: [id], onDelete: Cascade)
  team            Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  venue           Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy       Player              @relation(fields: [createdById], references: [id])

  @@index([searchId])
  @@index([teamId])
  @@index([venueId])
}

model TeamInvite {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  code        String   @unique
  createdById String
  createdBy   Player   @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  maxUses     Int      @default(1)
  uses        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([teamId])
  @@index([code])
}

// A player without a team asking to join one, found through the league team it
// is linked to. Its leader and the members who may invite answer it. A player
// waits on one request at a time; a refusal stays, so that team is not asked
// again by them.
model TeamJoinRequest {
  id            String            @id @default(cuid())
  playerId      String
  teamId        String
  status        JoinRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  answeredAt    DateTime? // When the team refused it
  refusalSeenAt DateTime? // When the player saw the refusal: it is not shown again
  player        Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([playerId, teamId])
  @@index([teamId, status])
}

// ============================================
// Balance Rules
// ============================================

model BalanceRule {
  id          String          @id @default(cuid())
  teamId      String
  ruleKey     String
  name        String
  description String?
  severity    BalanceSeverity @default(ERROR)
  enabled     Boolean         @default(true)
  params      Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, ruleKey])
  @@index([teamId])
}

// ============================================
// Notifications
// ============================================

// Something worth telling the players of a team, as information only: what
// happened and the facts to tell it, never a text or a medium. Each medium
// delivers it its own way; the app's bell through NotificationInboxEntry.
model Notification {
  id           String                   @id @default(cuid())
  kind         NotificationKind
  data         Json // The facts its kind needs, see shared/types/notification.types.ts
  teamId       String // The team it is told to
  createdAt    DateTime                 @default(now())
  team         Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inboxEntries NotificationInboxEntry[]

  @@index([createdAt])
  @@index([teamId])
}

// The app's bell: a notification delivered to one player, and when they saw it
model NotificationInboxEntry {
  notificationId String
  playerId       String
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([notificationId, playerId])
  @@index([playerId, readAt])
}

// ============================================
// Enums
// ============================================

// The roles of an account, the one a session acts as
enum AccountRole {
  PLAYER
  MANAGER
  ADMIN
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PARTIAL // Available to play on part of the day only: its hours in startTime and endTime
  VOICE_ONLY
}

enum EventType {
  MATCH
  EVENT
  VOICE_MEETING
  COMPETITION // A tournament the team plays, a month of its local league for one
}

enum VoiceMedium {
  DISCORD
  TEAMSPEAK
  MUMBLE
  WHATSAPP
  MESSENGER
  TELEGRAM
  GOOGLE_MEET
  OTHER
}

enum SubscriptionTier {
  BRONZE
  SILVER
  GOLD
}

enum BalanceSeverity {
  ERROR
  WARNING
}

enum ScrimSearchStatus {
  OPEN
  MATCHED // Closed after making matches: all those wanted, or no room left for another, or withdrawn by its team
  EXPIRED // Closed with no match made: its day passed, or its slots no longer hold a match
}

enum ScrimProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  CANCELLED // Accepted, then the match called off by one of the two teams
}

// Why a proposal was declined: by the team that searches, or by the app once
// the proposal no longer held
enum ScrimDeclineReason {
  BY_TEAM // The team that searches said no
  TIME_TAKEN // It accepted another match at that time
  SEARCH_FILLED // Its search found all its matches
  SEARCH_CLOSED // Its search closed: the slots left no longer hold a match
  RUN_TAKEN // A slot of the run was booked at the venue meanwhile
  SEARCH_CHANGED // Its search changed and no longer holds the run
  SEARCH_WITHDRAWN // Its search was withdrawn
  DAY_PASSED // The day passed with no answer
}

enum JoinRequestStatus {
  PENDING // Waiting for the team's answer
  REFUSED // The team said no: the player cannot ask it again
  CANCELLED // The player took it back: kept so that they ask that team again only a while after they asked it
}

enum NotificationKind {
  SCRIM_PROPOSAL_RECEIVED // Another team proposed a match on the team's search
  SCRIM_MATCH_MADE // A proposal was accepted: the match is in both calendars
  SCRIM_PROPOSAL_DECLINED // The team's proposal was declined, by the other team or by the app, and why (ScrimDeclineReason)
  SCRIM_SEARCH_WITHDRAWN // A search the team had a proposal pending on was withdrawn
  SCRIM_MATCH_CANCELLED // A match of the matchmaking was called off
  SCRIM_SEARCH_EXPIRED // The team's search closed with no match: its slots were booked
  TEAM_JOIN_REQUESTED // A player without a team asks to join it
  LEAGUE_REGISTRATION_OPEN // The registration to this month of the team's local league opened, the team not registered
  LEAGUE_REGISTRATION_CLOSING // It closes in a few days, the team still not registered
  COMPETITION_OFFERED // The team's venue published a competition for it, to add to its calendar or refuse
  COMPETITION_ADDED // A competition of the venue was accepted into the team's calendar
  COMPETITION_WITHDRAWN // The venue withdrew a competition the team had accepted, or not answered yet
  VENUE_EVENT_WITHDRAWN // The venue withdrew an event the team had added to its calendar
  COMPETITION_CHANGED // The venue changed a competition the team accepted, or has not answered yet
  VENUE_EVENT_CHANGED // The venue changed an event the team had added to its calendar
}
