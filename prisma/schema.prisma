generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Auth & Account Linking
// ============================================

model User {
  id                          String              @id @default(cuid())
  email                       String              @unique
  password                    String
  name                        String
  playerId                    String?             @unique
  managerId                   String?             @unique
  adminId                     String?             @unique
  linkedAccountGroupId        String?
  passwordResetToken          String?             @unique
  passwordResetTokenExpiresAt DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  player                      Player?             @relation(fields: [playerId], references: [id], onDelete: SetNull)
  manager                     Manager?            @relation(fields: [managerId], references: [id], onDelete: SetNull)
  admin                       Admin?              @relation(fields: [adminId], references: [id], onDelete: SetNull)
  linkedAccountGroup          LinkedAccountGroup? @relation(fields: [linkedAccountGroupId], references: [id])
  sessions                    Session[]

  @@index([linkedAccountGroupId])
}

model LinkedAccountGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  accounts  User[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ============================================
// Player (joueur affilié à une équipe)
// ============================================

model Player {
  id                      String                   @id @default(cuid())
  permissions             Json? // Granular permissions JSON
  teamId                  String?
  subscriptionTier        SubscriptionTier?
  subscriptionRenewalDate DateTime?                @db.Date // Renews every 30 days from this date
  evaUserId               Int?                     @unique // User id on eva.gg, stable across renames; one eva.gg account per player
  evaUsername             String? // eva.gg tag (Pseudo#123456) as it was when the player linked it; display only
  evaLinkedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User?
  team                    Team?                    @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeam                 Team?                    @relation("TeamLeader")
  availabilities          Availability[]
  createdEvents           CalendarEvent[]
  gamePlanPlayers         GamePlanPlayer[]
  createdInvites          TeamInvite[]
  openedScrimSearches     ScrimSearch[]
  sentScrimProposals      ScrimProposal[]
  notificationInbox       NotificationInboxEntry[]

  @@index([teamId])
}

// ============================================
// Manager (gérant de salle)
// ============================================

model Manager {
  id                       String         @id @default(cuid())
  permissions              Json? // Manager-specific permissions
  activationToken          String?        @unique
  activationTokenExpiresAt DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  user                     User?
  managedVenues            VenueManager[]
}

// ============================================
// Admin (administrateur)
// ============================================

model Admin {
  id                       String    @id @default(cuid())
  permissions              Json // Toutes les permissions admin (superAdmin = toutes à true)
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User?
}

// ============================================
// Team & Venue
// ============================================

model Team {
  id             String              @id @default(cuid())
  name           String
  // The team's logo, a small image kept in the database so it survives redeploys
  logoData       Bytes?
  logoType       String? // image/png, image/jpeg or image/webp, as read from the file itself
  logoUpdatedAt  DateTime? // Changes the logo URL, so browsers drop their cached copy
  venueId        String?
  leaderId       String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  venue          Venue?              @relation(fields: [venueId], references: [id])
  leader         Player              @relation("TeamLeader", fields: [leaderId], references: [id])
  members        Player[]            @relation("TeamMembers")
  balanceRules   BalanceRule[]
  gamePlans      GamePlan[]
  calendarEvents CalendarEvent[]
  invites        TeamInvite[]
  favoriteVenues TeamFavoriteVenue[]
  scrimSearches  ScrimSearch[]
  scrimProposals ScrimProposal[]
  notifications  Notification[]

  @@index([venueId])
}

// The venues a team plays at most often, in the order the team listed them.
// Quick access in the venue pickers; distinct from the affiliated venue.
model TeamFavoriteVenue {
  teamId   String
  venueId  String
  position Int
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([teamId, venueId])
  @@index([venueId])
}

model Venue {
  id         String              @id @default(cuid())
  externalId Int?                @unique // Location id on eva.gg, for venues filled by scripts/sync-venues.ts
  name       String
  city       String
  address    String
  phone      String?
  arenaCount Int                 @default(1) // Arenas the venue runs for the competitive game
  // Where the venue can be reached online, as eva.gg publishes them; hand-made venues fill them in the admin
  website    String?
  discord    String?
  facebook   String?
  instagram  String?
  x          String?
  tiktok     String?
  youtube    String?
  twitch     String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  teams      Team[]
  managers   VenueManager[]
  matches    CalendarEvent[]
  favoredBy  TeamFavoriteVenue[]
  scrimSlots ScrimSearchSlot[]
  scrimRuns  ScrimProposal[]
}

model VenueManager {
  id        String   @id @default(cuid())
  managerId String
  venueId   String
  createdAt DateTime @default(now())
  manager   Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([managerId, venueId])
  @@index([managerId])
  @@index([venueId])
}

// ============================================
// Game Plans & Maps
// ============================================

model Map {
  id        String     @id
  name      String
  images    Json       @default("[]")
  template  Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  gamePlans GamePlan[]
}

model GamePlan {
  id          String           @id @default(cuid())
  name        String
  mapId       String
  teamId      String?
  assignments Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  notes       Json?
  map         Map              @relation(fields: [mapId], references: [id], onDelete: Cascade)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players     GamePlanPlayer[]

  @@index([mapId])
  @@index([teamId])
}

model GamePlanPlayer {
  id               String   @id @default(cuid())
  gamePlanId       String
  playerId         String
  assignmentIds    Int[]
  mainAssignmentId Int?
  gamePlan         GamePlan @relation(fields: [gamePlanId], references: [id], onDelete: Cascade)
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gamePlanId, playerId])
  @@index([gamePlanId])
  @@index([playerId])
}

// ============================================
// Calendar & Availability
// ============================================

model Availability {
  id       String             @id @default(cuid())
  playerId String
  date     DateTime           @db.Date
  status   AvailabilityStatus
  player   Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@index([date])
}

model CalendarEvent {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  startTime     String
  endTime       String
  type          EventType
  title         String
  description   String?
  teamId        String?
  venueId       String? // Where a MATCH is played; other event types have none
  arenaNumber   Int? // Which arena of that venue, when the team knows it
  evaSlotIds    String[]     @default([]) // The eva.gg slots the match runs on, consecutive on one arena, in order; empty when none picked
  voiceMedium   VoiceMedium? // Where a VOICE_MEETING is held; other event types have none
  scrimSearchId String? // The search this match came out of, when the matchmaking created it
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  gamePlan      Json?
  team          Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  venue         Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdBy     Player       @relation(fields: [createdById], references: [id])
  scrimSearch   ScrimSearch? @relation(fields: [scrimSearchId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([teamId])
  @@index([venueId])
  @@index([scrimSearchId])
}

// A team's offer for a day: slots of one venue or more, and how many matches
// it wants to play on them that day, wherever they are played, each on a run
// of consecutive slots of one arena. A team plays one match at a time, so no
// two matches of a search overlap. One open search per team and day; a
// withdrawn search is deleted.
model ScrimSearch {
  id              String            @id @default(cuid())
  teamId          String
  date            DateTime          @db.Date
  slotCount       Int               @default(2) // How many consecutive slots a match takes (see SCRIM_MATCH_SLOTS_DEFAULT)
  matchCount      Int               @default(1) // How many matches the team wants that day (see SCRIM_MATCH_COUNT_DEFAULT)
  startTime       String // HH:mm, earliest offered slot
  endTime         String // HH:mm, end of the latest offered slot
  convocationTime String // HH:mm, when eva.gg expects the players for the earliest slot
  status          ScrimSearchStatus @default(OPEN)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  team            Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       Player            @relation(fields: [createdById], references: [id])
  slots           ScrimSearchSlot[]
  proposals       ScrimProposal[]
  matches         CalendarEvent[] // The match events its accepted proposals created, two per match

  @@index([teamId, date])
}

// A slot a search offers, with its venue, arena and times as eva.gg gave them
// when the search opened: the offer reads, and counts the matches it still
// holds, without asking eva.gg again
model ScrimSearchSlot {
  id              String      @id @default(cuid())
  searchId        String
  venueId         String
  evaSlotId       String
  arenaNumber     Int
  startTime       String // HH:mm
  endTime         String // HH:mm
  convocationTime String // HH:mm
  position        Int // Venue by venue in the team's order, arena by arena, then by time
  search          ScrimSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  venue           Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([searchId, evaSlotId])
  @@index([venueId])
}

// A team answers another team's search with the run of one match, in one of
// its venues. Accepting it creates the match in both calendars and declines
// the pending proposals at the same time; the search closes, declining the
// rest, once it has all its matches or its remaining slots no longer hold one.
model ScrimProposal {
  id              String              @id @default(cuid())
  searchId        String
  teamId          String // The team proposing, never the one that opened the search
  createdById     String
  message         String? // A word for the other team, optional
  venueId         String // Where the run is played
  evaSlotIds      String[] // The run to play: consecutive slots on one arena, among those the search offers
  arenaNumber     Int
  startTime       String // HH:mm, first slot of the run
  endTime         String // HH:mm, last slot of the run
  convocationTime String // HH:mm, for the first slot
  status          ScrimProposalStatus @default(PENDING)
  respondedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  search          ScrimSearch         @relation(fields: [searchId], references: [id], onDelete: Cascade)
  team            Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  venue           Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy       Player              @relation(fields: [createdById], references: [id])

  @@index([searchId])
  @@index([teamId])
  @@index([venueId])
}

model TeamInvite {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  code        String   @unique
  createdById String
  createdBy   Player   @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  maxUses     Int      @default(1)
  uses        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([teamId])
  @@index([code])
}

// ============================================
// Balance Rules
// ============================================

model BalanceRule {
  id          String          @id @default(cuid())
  teamId      String
  ruleKey     String
  name        String
  description String?
  severity    BalanceSeverity @default(ERROR)
  enabled     Boolean         @default(true)
  params      Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, ruleKey])
  @@index([teamId])
}

// ============================================
// Notifications
// ============================================

// Something worth telling the players of a team, as information only: what
// happened and the facts to tell it, never a text or a medium. Each medium
// delivers it its own way; the app's bell through NotificationInboxEntry.
model Notification {
  id           String                   @id @default(cuid())
  kind         NotificationKind
  data         Json // The facts its kind needs, see shared/types/notification.types.ts
  teamId       String // The team it is told to
  createdAt    DateTime                 @default(now())
  team         Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inboxEntries NotificationInboxEntry[]

  @@index([createdAt])
  @@index([teamId])
}

// The app's bell: a notification delivered to one player, and when they saw it
model NotificationInboxEntry {
  notificationId String
  playerId       String
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([notificationId, playerId])
  @@index([playerId, readAt])
}

// ============================================
// Enums
// ============================================

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  CONDITIONAL
  VOICE_ONLY
}

enum EventType {
  MATCH
  EVENT
  VOICE_MEETING
}

enum VoiceMedium {
  DISCORD
  TEAMSPEAK
  MUMBLE
  WHATSAPP
  MESSENGER
  TELEGRAM
  GOOGLE_MEET
  OTHER
}

enum SubscriptionTier {
  BRONZE
  SILVER
  GOLD
}

enum BalanceSeverity {
  ERROR
  WARNING
}

enum ScrimSearchStatus {
  OPEN
  MATCHED // Closed after making matches: all those wanted, or no room left for another, or withdrawn by its team
  EXPIRED // Closed with no match made: its day passed, or its slots no longer hold a match
}

enum ScrimProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  CANCELLED // Accepted, then the match called off by one of the two teams
}

enum NotificationKind {
  SCRIM_PROPOSAL_RECEIVED // Another team proposed a match on the team's search
  SCRIM_MATCH_MADE // A proposal was accepted: the match is in both calendars
  SCRIM_PROPOSAL_DECLINED // The team's proposal was turned down, by the other team or by the app
  SCRIM_SEARCH_WITHDRAWN // A search the team had a proposal pending on was withdrawn
  SCRIM_MATCH_CANCELLED // A match of the matchmaking was called off
  SCRIM_SEARCH_EXPIRED // The team's search closed with no match: its slots were booked
}
